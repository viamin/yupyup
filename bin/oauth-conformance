#!/bin/sh
# Interoperability harness for the OAuth runtime example (issue #24).
#
# Replays the RFC-anchored conformance case manifest against the
# compiled runtime, checks every step against the verified models (the
# #23 trace mapping), and reports each case as pass, FAIL, or
# unsupported with its documented reason. Exits 1 when any supported
# case fails.
#
# The external OpenID Foundation Conformance Suite is optional: when
# YUP_OIDF_SUITE names a suite deployment URL (for example
# https://www.certification.openid.net) or a local conformance-suite
# checkout, a deterministic plan.json hand-off is written for a manual
# suite run. Without it the external part is skipped with a note and
# the local subset still runs (exit 0 on pass). A set-but-missing
# checkout path or an unreachable URL is a configuration error and
# exits 1: a typo or a suite that cannot be talked to is not a skip.
#
# Usage:
#   bin/oauth-conformance [RUNTIME.yup]   # defaults to examples/oauth_runtime.yup
#
# Examples:
#   bin/oauth-conformance                              # the good runtime
#   bin/oauth-conformance examples/broken_oauth_runtime.yup   # the failing demo
#   YUP_OIDF_SUITE='https://www.certification.openid.net' bin/oauth-conformance
#   YUP_OIDF_SUITE=/path/to/conformance-suite bin/oauth-conformance
#
# See docs/LANGUAGE.md#oauth-interoperability-harness for details.

set -e

cd "$(dirname "$0")/.."

if ! command -v mix >/dev/null 2>&1; then
  echo "Warning: mix tool not available, skipping OAuth conformance harness"
  exit 0
fi

exec mix run --no-start -e 'Yup.Conformance.OAuth.main(System.argv())' -- "$@"
