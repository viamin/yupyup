# PKCE token exchange as a finite model.
#
# The stored challenge and the submitted verifier stay abstract atoms, and
# the cryptographic check itself (deriving the challenge from the verifier)
# is abstracted out of this model. What is modeled is the protocol rule: a
# token is issued only when the submitted verifier matches the stored
# challenge. No OAuth runtime endpoints are modeled here.
model PkceExchange
  state challenge = :known
  state verifier = :unknown
  state token_issued = false

  invariant "token requires matching verifier" do
    not token_issued or verifier == :matching
  end

  transition submit_valid_verifier do
    state.verifier = :matching
    state.token_issued = true
  end

  transition submit_invalid_verifier do
    state.verifier = :wrong
    state.token_issued = false
  end
end
